# Local machine config
configs/local_config.yml

# Ignore local training configs directly inside configs/training/
configs/training/local/*
configs/training/sweeps/*

# Ignore personal inference defaults and workflow overrides
configs/inference/local/*
!configs/inference/local/.gitkeep

# But keep subdirectories visible to Git rules and track tracked config sources
!configs/training/local/.gitkeep
!configs/training/*/
!configs/training/templates/**
!configs/training/examples/**
!configs/training/presets/**

# Keep graph development private except publication scripts/utilities
graphs/*
!graphs/paper/
!graphs/paper/**
!graphs/utils/
!graphs/utils/**

# zenodo upload helpers scripts with private access token
src/scripts/release/find_bucket_url.py
src/scripts/release/zenodo_upload.py

# internal lisai cache
.lisai/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / lint / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/

# Build and packaging artifacts
build/
dist/
.eggs/
*.egg-info/
pip-wheel-metadata/

# Notebook caches
.ipynb_checkpoints/

# IDE/editor settings
.vscode/
.idea/

# codex guidance
AGENTS.md

# Local Codex metadata
.codex/

# Common OS artifacts
.DS_Store
Thumbs.db
