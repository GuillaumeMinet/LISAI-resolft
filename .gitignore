# Machine-local selection, developer configurations and generated editor schemas.
# All writable experiment configurations are user-managed; immutable presets,
# templates and examples live under src/lisai/resources/configs instead.
/configs/local.yml
/configs/local_config.yml
/configs/training/
/configs/preprocess/
/configs/inference/
/configs/schema/

# Keep graph development private except publication scripts/utilities
graphs/*
!graphs/paper/
!graphs/paper/**
!graphs/utils/
!graphs/utils/**

# zenodo upload helpers scripts with private access token
src/scripts/release/find_bucket_url.py
src/scripts/release/zenodo_upload.py

# internal lisai cache
.lisai/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / lint / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/

# Build and packaging artifacts
build/
dist/
.eggs/
*.egg-info/
pip-wheel-metadata/

# Notebook caches
.ipynb_checkpoints/

# IDE/editor settings
.vscode/
.idea/

