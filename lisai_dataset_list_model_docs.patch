+def _dataset_readme_body(readme: str | None) -> str | None:
+    if readme is None:
+        return None
+    lines = readme.strip().splitlines()
+    if lines and lines[0].startswith("# "):
+        lines = lines[1:]
+        while lines and not lines[0].strip():
+            lines.pop(0)
+    body = "\n".join(lines).strip()
+    return body or None
